#!/bin/sh
# Starts Comic Stitcher from inside the AppImage.
HERE="$(dirname "$(readlink -f "$0")")"
# Matches the window to its app-menu entry on X11/XWayland desktops.
RESOURCE_NAME=comic-stitcher
export RESOURCE_NAME
# The drop tab starts itself at sign-in through this: the AppImage file itself,
# not the temporary folder it's mounted at while running.
if [ -n "${APPIMAGE:-}" ]; then
    COMIC_STITCHER_LAUNCHER="$APPIMAGE"
    export COMIC_STITCHER_LAUNCHER
fi
# Light or dark mode, file dialogs and the like from the desktop's own settings
# portal (GNOME, KDE and others), unless a Qt theme was chosen already.
if [ -z "${QT_QPA_PLATFORMTHEME:-}" ]; then
    QT_QPA_PLATFORMTHEME=xdgdesktopportal
    export QT_QPA_PLATFORMTHEME
fi
exec "$HERE/usr/lib/comic-stitcher/comic-stitcher" "$@"
